params {
    // Reference (GRCh38, UCSC-style chr-prefixed contigs — matches the HG002 source BAM)
    reference_fasta   = "${projectDir}/data/reference/GRCh38_chr15_chrX.fna"
    reference_dict    = "${projectDir}/data/reference/GRCh38_chr15_chrX.dict"
    regions_bed       = "${projectDir}/data/reference/regions.bed"

    // HG002 source BAM (remote, region-extracted — see docs/data_sources.md)
    hg002_bam_url     = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/data/AshkenazimTrio/HG002_NA24385_son/NIST_HiSeq_HG002_Homogeneity-10953946/NHGRI_Illumina300X_AJtrio_novoalign_bams/HG002.GRCh38.60x.1.bam"

    // GIAB truth set — NISTv4.2.1, GRCh38 (see docs/data_sources.md)
    truth_vcf_url     = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/AshkenazimTrio/HG002_NA24385_son/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz"
    truth_bed_url     = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/AshkenazimTrio/HG002_NA24385_son/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark_noinconsistent.bed"

    // CAPN3/DMD gene-scoped annotation (Ensembl release 116 GFF3 subset — see
    // scripts/fetch_gene_annotation.sh and docs/data_sources.md)
    gene_annotation_gff = "${projectDir}/data/reference/CAPN3_DMD.gff3.gz"

    // gnomAD v4.1 genomes sites VCFs (remote, region-extracted — see docs/data_sources.md)
    gnomad_chr15_url  = "https://storage.googleapis.com/gcp-public-data--gnomad/release/4.1/vcf/genomes/gnomad.genomes.v4.1.sites.chr15.vcf.bgz"
    gnomad_chrx_url   = "https://storage.googleapis.com/gcp-public-data--gnomad/release/4.1/vcf/genomes/gnomad.genomes.v4.1.sites.chrX.vcf.bgz"

    outdir            = "${projectDir}/results"
}

process {
    cpus   = 4
    memory = '8 GB'
}

executor {
    cpus   = 4
    memory = '8 GB'
}

profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}
